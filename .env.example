# Used by the browser app (anon key is safe to expose; RLS protects the data)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Edge Function secrets — set with:  supabase secrets set FAMILY_JWT_SECRET=... ALLOWED_ORIGIN=...
# NEVER put these in the browser app or commit them.
FAMILY_JWT_SECRET=the-project-JWT-secret-from-Settings-API
ALLOWED_ORIGIN=https://your-app.vercel.app
